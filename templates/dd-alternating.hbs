<div class="dd-alternating {{parent_type}} {{parent_class}}" role="region">
  <div class="dd-alternating__items dd-g">
    {{#each items}}
    <div class="dd-alternating__item dd-u-1-1">
      <div class="dd-alternating__content dd-g">
        <div class="dd-alternating__image dd-u-1-1 dd-u-sm-1-1 dd-u-md-1-1 dd-u-lg-12-24"{{{sal_attr}}}>
          {{> _media media}}
        </div>
        <div class="dd-alternating__copy l-box dd-u-1-1 dd-u-sm-1-1 dd-u-md-1-1 dd-u-lg-12-24"{{{sal_attr}}}>
          <div class="dd-alternating__title">
            <h2>{{child_title}}</h2>
          </div>
          {{#if child_subtitle}}
          <div class="dd-alternating__subtitle">
            <strong>{{child_subtitle}}</strong>
          </div>
          {{/if}}
          <div class="dd-alternating__body">
            {{{child_copy_html}}}
            {{#if has_links}}
            <div class="dd-alternating__links dd-g">
              {{#each links}}
              <div class="dd-alternating__link">
                <a href="{{url}}" target="{{target}}" class="dd-button {{style}}">{{label}}</a>
              </div>
              {{/each}}
            </div>
            {{/if}}
          </div>
        </div>
      </div>
    </div>
    {{/each}}
  </div>
</div>
