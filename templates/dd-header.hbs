{{/if}}{{{alert_html}}}
  <div class="dd-header__top">
{{{sections_html}}}
{{#if cta_url}}    <div class="dd-header__cta"><a href="{{cta_url}}" class="dd-button -primary">{{cta_label}}</a></div>
{{/if}}  </div>
