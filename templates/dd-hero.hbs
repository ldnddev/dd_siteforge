<section class="dd-hero{{#if parent_class}} {{parent_class}}{{/if}}{{#if overlay}} {{overlay}}{{/if}}{{#if copy_position}} {{copy_position}}{{/if}}{{#if parent_custom_css}} {{parent_custom_css}}{{/if}}"{{#if id}} id="{{id}}"{{/if}} aria-label="{{aria_label}}">
  {{#if media.has_media}}<div class="dd-hero__image {{parent_image_class}}">
    {{> _media media}}
    {{#if media.is_image}}<style>
    .dd-hero__image {
      background-image: url('{{bg_mobile}}');
    }
    @media only screen and (min-width: 64em) {
      .dd-hero__image {
        background-image: url('{{bg_desktop}}');
      }
    }
  </style>{{/if}}
  </div>{{/if}}
  <div class="dd-hero__content dd-g"{{{sal_attr}}}>
    <div class="dd-hero__copy dd-u-1-1 dd-u-lg-12-24">
      <div class="dd-hero__title"><h1>{{parent_title}}</h1></div>
      {{#if parent_subtitle}}<div class="dd-hero__subtitle"><strong>{{parent_subtitle}}</strong></div>{{/if}}
      {{#if has_body}}<div class="dd-hero__body">
        {{#if parent_copy_html}}{{{parent_copy_html}}}{{/if}}
        {{#if has_links}}<div class="dd-hero__links dd-g">
          {{#each links}}<div class="dd-hero__link">
            <a href="{{url}}" target="{{target}}" class="dd-button {{style}}">{{label}}</a>
          </div>{{/each}}
        </div>{{/if}}
      </div>{{/if}}
    </div>
  </div>
</section>
