<div class="dd-scrolltop">
  <div class="dd-scrolltop__link">
    <a href="#page_top" title="Click to scroll to the top of the page.">
      <svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24">
        <path d="M0 0h24v24H0z" fill="none"></path>
        <path fill="currentColor" d="M7.41 18.41L6 17l6-6l6 6l-1.41 1.41L12 13.83zm0-6L6 11l6-6l6 6l-1.41 1.41L12 7.83z"></path>
      </svg>
    </a>
  </div>
</div>
<div id="cookie-consent" class="l-box">
  <p>We use cookies to enhance your experience. Do you consent to Google tracking?</p>
  <button class="accept dd-button -primary" onclick="handleCookieConsent('accept')">Accept</button>
  <button class="decline dd-button -secondary" onclick="handleCookieConsent('decline')">Decline</button>
</div>
<footer class="dd-footer{{custom}}">
  <div class="dd-footer__content">
{{#if blurb}}    <div class="dd-footer__blurb l-box">{{{blurb}}}</div>
{{/if}}{{{sections_html}}}
{{#if has_socials}}    <div class="dd-footer__navigation navigation -social-menu">
      <nav aria-label="Social">
        <ul class="menu">
          {{#each socials}}<li class="menu-item"><a href="{{url}}" target="_blank" rel="noopener noreferrer"><span class="visually-hidden">{{label}}</span><i class="fa-brands {{icon}}" aria-hidden="true"></i></a></li>{{/each}}
        </ul>
      </nav>
    </div>
{{/if}}  </div>
  <div class="dd-footer__copyright"><div class="l-box">{{copyright}}</div></div>
</footer>
